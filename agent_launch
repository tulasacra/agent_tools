#!/usr/bin/env bash
set -euo pipefail

name=$(basename "$0")

launch() {
  case "$1" in
    cursor) exec agent ;;
    copilot) exec copilot ;;
    codex) exec codex ;;
  esac
}

if [[ ! -t 0 ]]; then
  echo "$name: need a terminal" >&2
  exit 1
fi

printf '  1  Cursor (xAI)\n  2  Copilot (GitHub)\n  3  Codex (OpenAI)\n> ' >&2
IFS= read -rsn1 key || exit 1
printf '\n' >&2

case "$key" in
  1) launch cursor ;;
  2) launch copilot ;;
  3) launch codex ;;
esac
