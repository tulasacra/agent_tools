#!/usr/bin/env python3
import argparse
import concurrent.futures
import json
import math
import re
import subprocess
import threading
import urllib.error
import urllib.request
from datetime import datetime, timedelta, timezone
from pathlib import Path

HOME = Path.home()
REQUEST_TIMEOUT = 30
tls = threading.local()


def http_json(url, headers, method="GET", body=None):
    data = None if body is None else json.dumps(body).encode()
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    with urllib.request.urlopen(req, timeout=REQUEST_TIMEOUT) as response:
        return json.load(response)


def local_dt(value):
    if isinstance(value, (int, float)) or (isinstance(value, str) and value.isdigit()):
        number = float(value)
        if number > 10_000_000_000:
            number /= 1000
        moment = datetime.fromtimestamp(number, timezone.utc)
    else:
        text = str(value)
        if len(text) == 10 and text[4] == "-" and text[7] == "-":
            moment = datetime.fromisoformat(text).replace(tzinfo=timezone.utc)
        else:
            moment = datetime.fromisoformat(text.replace("Z", "+00:00"))
            if moment.tzinfo is None:
                moment = moment.replace(tzinfo=timezone.utc)
    return moment.astimezone()


def epoch_seconds(value):
    number = float(value)
    if number > 10_000_000_000:
        number /= 1000
    return number


def calendar_month_seconds(reset_at):
    end = local_dt(reset_at).astimezone(timezone.utc)
    # Copilot premium quotas reset on the first at 00:00 UTC. Only infer a
    # calendar month when the reported reset agrees with that boundary.
    if end != end.replace(day=1, hour=0, minute=0, second=0, microsecond=0):
        return None
    start = (end - timedelta(days=1)).replace(day=1)
    return (end - start).total_seconds()


def remaining(reset_at, window_seconds):
    seconds = (reset_at - datetime.now().astimezone()).total_seconds()
    if seconds <= 0:
        return "now", "", ""
    period = "?"
    if window_seconds is not None:
        days = window_seconds / 86400
        if abs(days - round(days)) < 0.01:
            period = str(int(round(days)))
        else:
            period = f"{days:.1f}"
    return f"{seconds / 86400:.1f}", period, "days"


def manual_reset_count(value):
    return value if type(value) is int and value >= 0 else None


def manual_reset_expiration(value):
    if not isinstance(value, str) or not re.fullmatch(
            r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\.[0-9]+)?"
            r"(?:Z|[+-](?:[01][0-9]|2[0-3]):[0-5][0-9])", value):
        return None
    try:
        return datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(timezone.utc).isoformat()
    except (ValueError, OverflowError):
        return None


def manual_reset_dates(value):
    if not isinstance(value, list):
        return None
    dates = [manual_reset_expiration(date) for date in value]
    known = sorted((date for date in dates if date is not None), key=datetime.fromisoformat)
    return known + [None] * dates.count(None)


def manual_reset_details(data):
    if not isinstance(data, dict):
        return None, None
    available = manual_reset_count(data.get("available_count"))
    credits = data.get("credits")
    if not isinstance(credits, list) or any(not isinstance(credit, dict) for credit in credits):
        return available, None
    dates = [credit.get("expires_at") for credit in credits
             if credit.get("status") == "available" and credit.get("reset_type") == "codex_rate_limits"]
    return available, manual_reset_dates(dates)


def manual_reset_cells(record):
    count = manual_reset_count(record.get("manual_resets_available"))
    balance = f"Manual resets available: {count if count is not None else '?'}"
    if count == 0:
        return balance, "", ""
    dates = manual_reset_dates(record.get("manual_reset_expirations"))
    if not dates or dates[0] is None:
        return balance, "?", "?"
    incomplete = count is None or len(dates) != count or None in dates
    earliest = local_dt(dates[0])
    seconds = (earliest - datetime.now().astimezone()).total_seconds()
    countdown = "now" if seconds <= 0 else f"{seconds / 86400:.1f} days"
    expiry = earliest.strftime("%d.%m.%y %H:%M")
    if incomplete:
        expiry += " (earliest known)"
    if seconds <= 0:
        expiry += " (passed; refresh)"
    return balance, countdown, expiry


def row(label, percent, reset_at, window_seconds, *, manual_resets_available=None,
        manual_reset_expirations=None):
    percent = float(percent)
    if not math.isfinite(percent) or percent < 0:
        raise ValueError("usage response has an invalid percentage")
    if window_seconds is not None:
        window_seconds = float(window_seconds)
        if not math.isfinite(window_seconds) or window_seconds <= 0:
            raise ValueError("usage response has an invalid window duration")
    tls.entries.append({
        "provider": tls.provider,
        "label": label,
        "used_percent": percent,
        "reset_at": local_dt(reset_at).astimezone(timezone.utc).isoformat() if reset_at is not None else None,
        "window_seconds": window_seconds,
        "manual_resets_available": manual_reset_count(manual_resets_available),
        "manual_reset_expirations": manual_reset_dates(manual_reset_expirations),
        "error": None,
    })


def fail(label, message):
    tls.entries.append({
        "provider": tls.provider,
        "label": label,
        "used_percent": None,
        "reset_at": None,
        "window_seconds": None,
        "manual_resets_available": None,
        "manual_reset_expirations": None,
        "error": message,
    })


def print_table(rows):
    entries = []
    _, reset_index = max(
        ((record["window_seconds"] == 7 * 86400, index)
         for index, record in enumerate(rows) if record["provider"] == "codex"),
        default=(False, -1),
    )
    reset_cells = manual_reset_cells(rows[reset_index]) if reset_index >= 0 else None
    for record in rows:
        if record["error"] is not None:
            entries.append((record["label"], record["error"]))
            continue
        if record["reset_at"] is None:
            entries.append((record["label"], f"{record['used_percent']:.1f}%", "—", "", "", "—"))
            continue
        when = local_dt(record["reset_at"])
        left, period, unit = remaining(when, record["window_seconds"])
        date = when.strftime("%d.%m.%y %H:%M")
        entries.append((record["label"], f"{record['used_percent']:.1f}%", left, period, unit, date))

    agent_w = len("Agent")
    used_w = len("Used")
    num_w = 0
    period_w = 0
    unit_w = 0
    date_w = len("Reset date")
    for entry in entries:
        agent_w = max(agent_w, len(entry[0]))
        if len(entry) == 2:
            continue
        used_w = max(used_w, len(entry[1]))
        if entry[2] != "—":
            num_w = max(num_w, len(entry[2]))
        period_w = max(period_w, len(entry[3]))
        unit_w = max(unit_w, len(entry[4]))
        date_w = max(date_w, len(entry[5]))

    if reset_cells is not None:
        agent_w = max(agent_w, len(reset_cells[0]) - used_w)

    left_w = num_w
    if period_w:
        left_w += 1 + period_w
    if unit_w:
        left_w += 1 + unit_w
    left_w = max(left_w, len("Resets in"))
    if reset_cells is not None:
        left_w = max(left_w, len(reset_cells[1]))

    def left_cell(number, period, unit):
        if number == "—":
            return f"{number:<{left_w}}"
        text = f"{number:>{num_w}}" if num_w else ""
        if period_w:
            if period:
                text += "/" + f"{period:>{period_w}}"
            else:
                text += " " * (1 + period_w)
        if unit_w:
            text += " " + f"{unit:<{unit_w}}"
        return f"{text:<{left_w}}"

    print(
        f"{'Agent':<{agent_w}}  "
        f"{'Used':>{used_w}}  "
        f"{'Resets in':<{left_w}}  "
        f"{'Reset date':<{date_w}}".rstrip()
    )
    print(
        f"{'-' * agent_w}  "
        f"{'-' * used_w}  "
        f"{'-' * left_w}  "
        f"{'-' * date_w}"
    )
    for index, (record, entry) in enumerate(zip(rows, entries)):
        if len(entry) == 2:
            print(f"{entry[0]:<{agent_w}}  {entry[1]}")
        else:
            label, used, number, period, unit, date = entry
            print(
                f"{label:<{agent_w}}  "
                f"{used:>{used_w}}  "
                f"{left_cell(number, period, unit)}  "
                f"{date:<{date_w}}".rstrip()
            )
        if index == reset_index:
            balance, countdown, expiry = reset_cells
            balance_w = agent_w + used_w
            if countdown.endswith(" days"):
                countdown = countdown.rjust(left_w)
            print(f"  {balance:<{balance_w}}  {countdown:<{left_w}}  {expiry}".rstrip())


def cursor_secret_token(secret):
    try:
        data = json.loads(secret)
    except json.JSONDecodeError:
        return None
    token = data.get("accessToken") if isinstance(data, dict) else None
    return token if isinstance(token, str) and token else None


def cursor_token():
    # Older Cursor installs keep the token in auth.json. Current ones leave
    # {"storedIn": "os-secret-store"} and put the token in the secret store.
    try:
        auth = json.loads((HOME / ".config/cursor/auth.json").read_text())
    except (OSError, json.JSONDecodeError):
        auth = None
    if isinstance(auth, dict):
        token = auth.get("accessToken")
        if isinstance(token, str) and token:
            return token
    try:
        out = subprocess.run(
            ["secret-tool", "search", "--all", "service", "cursor-credentials"],
            check=True,
            capture_output=True,
            text=True,
            timeout=REQUEST_TIMEOUT,
        ).stdout
    except (OSError, subprocess.CalledProcessError):
        out = ""
    for line in out.splitlines():
        if line.startswith("secret = "):
            token = cursor_secret_token(line.split("=", 1)[1].strip())
            if token:
                return token
    for path in (HOME / ".local/share/keyrings").glob("*.keyring"):
        text = path.read_text(errors="replace")
        for block in text.split("item-type="):
            if "value=cursor-credentials" not in block:
                continue
            for line in block.splitlines():
                if line.startswith("secret="):
                    token = cursor_secret_token(line.split("=", 1)[1].strip())
                    if token:
                        return token
    raise RuntimeError("cursor login not found")


def cursor_rows():
    token = cursor_token()
    data = http_json(
        "https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage",
        {
            "Authorization": f"Bearer {token}",
            "Content-Type": "application/json",
            "Connect-Protocol-Version": "1",
        },
        method="POST",
        body={},
    )
    plan = data.get("planUsage") or {}
    inhouse = plan.get("autoPercentUsed")
    api = plan.get("apiPercentUsed")
    reset = data.get("billingCycleEnd")
    start = data.get("billingCycleStart")
    if inhouse is None or api is None or reset is None or start is None:
        raise RuntimeError("usage response has no period total")
    window = epoch_seconds(reset) - epoch_seconds(start)
    row("Cursor (Grok)", inhouse, reset, window)
    row("Cursor (*)", api, reset, window)


def copilot_token():
    try:
        out = subprocess.run(
            ["secret-tool", "search", "--all", "service", "copilot-cli"],
            check=True,
            capture_output=True,
            text=True,
            timeout=REQUEST_TIMEOUT,
        ).stdout
    except (OSError, subprocess.CalledProcessError):
        out = ""
    secret = None
    for line in out.splitlines():
        if line.startswith("secret = "):
            secret = line.split("=", 1)[1].strip()
    if secret:
        return secret
    for path in (HOME / ".local/share/keyrings").glob("*.keyring"):
        text = path.read_text(errors="replace")
        blocks = text.split("item-type=")
        for block in blocks:
            if "value=copilot-cli" not in block:
                continue
            for line in block.splitlines():
                if line.startswith("secret="):
                    return line.split("=", 1)[1].strip()
    raise RuntimeError("copilot login not found")


def copilot_rows():
    token = copilot_token()
    data = http_json(
        "https://api.github.com/copilot_internal/user",
        {
            "Authorization": f"token {token}",
            "Accept": "application/json",
            "Editor-Version": "vscode/1.99.0",
            "Editor-Plugin-Version": "copilot/1.0.0",
            "User-Agent": "GitHubCopilot/1.0",
        },
    )
    snap = (data.get("quota_snapshots") or {}).get("premium_interactions") or {}
    remaining = snap.get("percent_remaining")
    reset = data.get("quota_reset_date")
    if remaining is None or not reset:
        raise RuntimeError("usage response has no premium quota")
    row("Copilot (*)", 100 - float(remaining), reset, calendar_month_seconds(reset))


def codex_rows():
    auth = json.loads((HOME / ".codex/auth.json").read_text())
    tokens = auth["tokens"]
    headers = {
        "Authorization": f"Bearer {tokens['access_token']}",
        "ChatGPT-Account-ID": tokens["account_id"],
        "Accept": "application/json",
    }
    # These requests share the same timeout budget; row construction stays on
    # this provider thread because the row accumulator is thread-local.
    with concurrent.futures.ThreadPoolExecutor(max_workers=2) as executor:
        usage_request = executor.submit(http_json, "https://chatgpt.com/backend-api/wham/usage", headers)
        details_request = executor.submit(http_json, "https://chatgpt.com/backend-api/wham/rate-limit-reset-credits", headers)
        try:
            details = details_request.result()
        except urllib.error.HTTPError as error:
            error.close()
            details = None
        except Exception:
            details = None
        data = usage_request.result()
    credits = data.get("rate_limit_reset_credits")
    # The shared balance is separate from credits applicable to current limits.
    available = credits.get("available_count") if isinstance(credits, dict) else None
    detail_count, expirations = manual_reset_details(details)
    if detail_count is not None:
        available = detail_count
    windows = data.get("rate_limit") or {}
    shown = False
    for window in windows.values():
        if not isinstance(window, dict):
            continue
        percent = window.get("used_percent")
        reset = window.get("reset_at")
        window_seconds = window.get("limit_window_seconds")
        if percent is None or reset is None or not window_seconds:
            continue
        period = {7 * 86400: "7d", 5 * 3600: "5h"}.get(float(window_seconds))
        label = f"Codex (Gpt {period})" if period else "Codex (Gpt)"
        row(label, percent, reset, window_seconds,
            manual_resets_available=available, manual_reset_expirations=expirations)
        shown = True
    if not shown:
        raise RuntimeError("usage response has no rate limit windows")
    tls.entries.sort(key=lambda entry: entry["window_seconds"], reverse=True)


def antigravity_rows():
    try:
        out = subprocess.run(
            ["agy", "--new-project", "--output-format", "json", "-p", "/usage"],
            check=True,
            capture_output=True,
            text=True,
            timeout=REQUEST_TIMEOUT,
        ).stdout
    except (OSError, subprocess.CalledProcessError):
        out = ""
    shown = False
    try:
        data = json.loads(out)
        groups = data.get("command", {}).get("data", {}).get("groups", [])
    except (json.JSONDecodeError, KeyError, TypeError, ValueError):
        groups = []

    if groups:
        for group in groups:
            group_name = group.get("name", "")
            model = "Argon" if "Argon" in group_name else "Gemini" if "Gemini" in group_name else "*"
            for bucket in group.get("buckets", []):
                window_kind = bucket.get("window", "")
                name = bucket.get("name", "")
                period, window = {
                    "weekly": ("7d", 7 * 86400),
                    "5h": ("5h", 5 * 3600),
                }.get(window_kind, (
                    "7d" if "Weekly" in name else "5h" if "Five Hour" in name else window_kind or "unknown",
                    7 * 86400 if "Weekly" in name else 5 * 3600 if "Five Hour" in name else None,
                ))
                remaining_fraction = bucket.get("remaining_fraction")
                if remaining_fraction is not None:
                    percent = max(0.0, (1.0 - float(remaining_fraction)) * 100.0)
                    timer_started = float(remaining_fraction) < 1.0 or bool(bucket.get("description"))
                else:
                    percent = 0.0
                    timer_started = False
                reset_at = bucket.get("reset_time") if timer_started else None
                row(f"Antigravity ({model} {period})", percent, reset_at, window)
                shown = True
    else:
        for line in out.splitlines():
            parts = line.split("\t")
            if len(parts) < 4:
                continue
            group = parts[0].strip()
            kind = parts[1].strip().removesuffix(" Remaining")
            if not kind.endswith("Limit"):
                continue
            kind = kind.removeprefix(group).strip()
            try:
                percent_str = "".join(c for c in parts[2] if c.isdigit() or c == ".")
                percent = 100.0 - float(percent_str)
            except ValueError:
                continue
            model = "Argon" if "Argon" in group else "Gemini" if "Gemini" in group else "*"
            # /usage names both windows explicitly. New or unspecified periods
            # must not silently turn into a five-hour window.
            period, window = {
                "Weekly Limit": ("7d", 7 * 86400),
                "Five Hour Limit": ("5h", 5 * 3600),
            }.get(kind, (kind.removesuffix("Limit").strip() or "unknown", None))
            reset_at = None if percent <= 0.0 else parts[3].strip()
            row(f"Antigravity ({model} {period})", percent, reset_at, window)
            shown = True
    if not shown:
        raise RuntimeError("usage response has no limits")


def fetch_wrapper(label, fetch):
    tls.entries = []
    tls.provider = label.lower()
    try:
        fetch()
    except urllib.error.HTTPError as error:
        fail(label, f"http {error.code}")
        error.close()
    except (TimeoutError, subprocess.TimeoutExpired):
        fail(label, f"request timed out after {REQUEST_TIMEOUT}s")
    except Exception as error:
        fail(label, str(error))
    return tls.entries


def collect_rows():
    fetches = [
        ("Cursor", cursor_rows),
        ("Copilot", copilot_rows),
        ("Codex", codex_rows),
        ("Antigravity", antigravity_rows),
    ]
    with concurrent.futures.ThreadPoolExecutor(max_workers=len(fetches)) as executor:
        futures = [executor.submit(fetch_wrapper, label, fetch) for label, fetch in fetches]
        # Read in provider order, regardless of which request finishes first.
        return [entry for future in futures for entry in future.result()]


def main(argv=None):
    parser = argparse.ArgumentParser(description="Show AI agent quota usage.")
    parser.add_argument("--json", action="store_true", help="print a timestamped JSON snapshot")
    args = parser.parse_args(argv)
    rows = collect_rows()
    if args.json:
        print(json.dumps({
            "generated_at": datetime.now(timezone.utc).isoformat(),
            "rows": rows,
        }, allow_nan=False))
    else:
        print_table(rows)


if __name__ == "__main__":
    main()
